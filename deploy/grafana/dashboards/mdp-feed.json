  {
   "type": "timeseries",
   "title": "Packets/s per line",
   "description": "",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "pps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (channel,feed,line) (rate(mdp_line_packets_total{channel=~\"$channel\"}[1m]))",
     "legendFormat": "ch {{channel}} {{feed}} {{line}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "A/B arbitration: wins vs duplicates",
   "description": "Wins = first arrival used. A line that keeps losing the race points to a slower path.",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "pps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (channel,line) (rate(mdp_line_wins_total{channel=~\"$channel\",feed=\"incremental\"}[1m]))",
     "legendFormat": "wins {{line}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (channel,line) (rate(mdp_line_duplicates_total{channel=~\"$channel\",feed=\"incremental\"}[1m]))",
     "legendFormat": "dups {{line}}",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (channel,line) (rate(mdp_line_late_total{channel=~\"$channel\",feed=\"incremental\"}[1m]))",
     "legendFormat": "late {{line}}",
     "refId": "C"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Loss per line vs after arbitration",
   "description": "Per-line gaps are absorbed by the other line; channel gaps trigger snapshot recovery.",
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
