    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (channel,line) (increase(mdp_line_gaps_total{channel=~\"$channel\",feed=\"incremental\"}[1m]))",
     "legendFormat": "line {{line}} gaps",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (channel) (increase(mdp_channel_gaps_total{channel=~\"$channel\",feed=\"incremental\"}[1m]))",
     "legendFormat": "CHANNEL gaps (both lines)",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (channel) (increase(mdp_channel_gap_packets_total{channel=~\"$channel\",feed=\"incremental\"}[1m]))",
     "legendFormat": "CHANNEL lost packets",
     "refId": "C"
    }
   ]
  },
